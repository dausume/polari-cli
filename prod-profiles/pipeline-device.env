# THE PIPELINE DEVICE (ci-8): the Polari instance that holds the build pipeline's SETTINGS. The `cicd` module is always in the floor set here — that is what "always enabled with the pipeline" means.
POL_PROD_ROUTE=swarm
POL_PROD_DOMAIN=
POL_PROD_WWW=off
POL_PROD_EXPOSURE_IP=
POL_PROD_DNS_PROVIDER=registrar
POL_PROD_STASH=none
POL_PROD_CERT_MODE=selfsigned
POL_PROD_LE_CHALLENGE=http
POL_PROD_LE_EMAIL=
POL_PROD_AUTH=off
POL_PROD_MODULES=polariapps,appstore,islemesh,terms,security,iso,cicd
POL_PROD_DEBS=skip
POL_PROD_DEMO=off
POL_PROD_IMAGE_REPO=
POL_PROD_IMAGE_TAG=
POL_PROD_ODOO=off
POL_PROD_POSTURE=dev
POL_PROD_PROFILE=lean
POL_PROD_APP_PERMISSIONS=advisory
