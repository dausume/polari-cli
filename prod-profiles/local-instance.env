# A normally hosted, locally accessible Polari: this machine, reachable on the LAN by name, user logins on,
# published images pulled, no installers, no demonstration notice. The name resolves anywhere on the internet
# to your LAN address through nip.io; offline, add the names to /etc/hosts.
POL_PROD_ROUTE=swarm
POL_PROD_DOMAIN=${LAN_IP}.nip.io
POL_PROD_WWW=off
POL_PROD_EXPOSURE_IP=${LAN_IP}
POL_PROD_DNS_PROVIDER=registrar
POL_PROD_STASH=none
POL_PROD_CERT_MODE=self-signed
POL_PROD_LE_CHALLENGE=http
POL_PROD_LE_EMAIL=
POL_PROD_AUTH=keycloak
POL_PROD_MODULES=polariapps,appstore,islemesh,terms
POL_PROD_DEBS=skip
POL_PROD_DEMO=off
POL_PROD_IMAGE_REPO=ghcr.io/dausume/
POL_PROD_IMAGE_TAG=polari-v2026.09.12-core
POL_PROD_ODOO=off
