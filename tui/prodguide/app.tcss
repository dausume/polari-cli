Screen { layout: vertical; }
#body { height: 1fr; }
#side { width: 30; min-width: 24; border-right: solid $primary-darken-2; padding: 0 1; }
.side-title { text-style: bold; color: $accent; padding: 1 0 0 0; }
#steps { height: auto; max-height: 14; background: transparent; }
#steps > ListItem { padding: 0 1; }
#side-facts { color: $text-muted; padding: 1 0; }
#main { padding: 0 2; }
#main Markdown { margin: 0 0 1 0; }
.q { text-style: bold; margin: 1 0 0 0; }
.note { color: $text-muted; margin: 1 0 0 0; }
RadioSet { width: 100%; }
Input { width: 100%; }
DataTable { height: auto; max-height: 14; margin: 1 0; }
#nav { height: 5; dock: bottom; padding: 0 1; border-top: solid $primary-darken-2; align-vertical: middle; }
#problems { width: 1fr; color: $error; padding: 1 1 0 0; }
#back, #next { margin: 0 1; }
#log { height: 1fr; min-height: 12; border: solid $primary-darken-2; }
#after { height: 3; }
#after Button { margin: 0 1; }
#problems-top { display: none; background: $error 25%; color: $text; border: solid $error; padding: 0 1; margin: 0 0 1 0; text-style: bold; }
.todo { display: none; background: $warning 20%; border: solid $warning; padding: 0 1; margin: 1 0 0 0; }
/* selection must be unmistakable: the chosen row is tinted and bold; the grey bar is only keyboard focus */
RadioButton.-on { background: $success 25%; text-style: bold; }
RadioButton.-on > .toggle--button { color: $success; text-style: bold; }
RadioButton:focus { border-left: tall $accent; }
Checkbox.-on { background: $success 25%; text-style: bold; }
